<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Cron Job to Automatically Fetch Attendance -->

     <record id="ir_cron_fetch_attendance" model="ir.cron">
            <field name="name">Fetch Attendance</field>
            <field name="model_id" ref="model_attendance_punching"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_attendance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>

</odoo>
